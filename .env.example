# ═══════════════════════════════════════════════════════════════════
# E-Commerce Agents — Variables de entorno
# Copiá este archivo como .env y completá con tus valores reales.
# NUNCA commitees .env con valores reales.
# ═══════════════════════════════════════════════════════════════════

# ── LLM Provider ──────────────────────────────────────────────────
LLM_PROVIDER=groq           # groq | gemini | anthropic
GROQ_API_KEY=               # https://console.groq.com → API Keys
GEMINI_API_KEY=             # (opcional)
ANTHROPIC_API_KEY=          # (opcional)

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379   # Docker local. En Render: se inyecta automático.

# ── Fuente de datos ───────────────────────────────────────────────
DAL_MODE=sheets             # sheets | excel
SHEETS_CREDENTIALS_PATH=config/credentials.json   # local; en cloud se usa GOOGLE_CREDENTIALS_JSON
SHEETS_SPREADSHEET_ID=      # ID de la hoja de Google Sheets

# ── Cloud deploy: credenciales Google en base64 ───────────────────
# En Render/Railway NO subas credentials.json. En su lugar:
#   cat config/credentials.json | base64 -w0
# y pegá el resultado aquí:
GOOGLE_CREDENTIALS_JSON=    # (solo para cloud; dejar vacío en local)

# ── MercadoLibre ──────────────────────────────────────────────────
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_ACCESS_TOKEN=
MELI_REFRESH_TOKEN=
MELI_SELLER_ID=

# ── WhatsApp Business (Meta Cloud API) ────────────────────────────
WPP_PHONE_NUMBER_ID=
WPP_ACCESS_TOKEN=
WPP_VERIFY_TOKEN=           # Elegí un token secreto, ej: mi_empresa_verify_2026
WPP_APP_SECRET=

# ── Sistema ───────────────────────────────────────────────────────
ADMIN_API_KEY=              # Clave para endpoints /admin/*
CONFIG_PATH=config/business.yaml
ENV=development             # development | production
